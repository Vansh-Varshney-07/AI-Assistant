# Tavily Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Optional NVIDIA API Key for workbench
# NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Google Gemini (Model Provider) ──────────────────────────────────────────
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here

# ── Google Workspace Skill (OAuth 2.0) ──────────────────────────────────────
# Setup credentials in: https://console.cloud.google.com/apis/credentials
# Path to your downloaded OAuth 2.0 Desktop client secret JSON file
GOOGLE_WORKSPACE_CREDENTIALS_PATH=secrets/credentials.json
# Path where the generated OAuth refresh token will be saved
GOOGLE_WORKSPACE_TOKEN_PATH=secrets/token.json

# ── Notion Integration (Knowledge Harness) ───────────────────────────────────
# Create an internal integration at: https://www.notion.so/my-integrations
# Make sure to invite/connect your integration to pages or databases you want it to access
NOTION_API_KEY=secret_your_notion_integration_token_here

